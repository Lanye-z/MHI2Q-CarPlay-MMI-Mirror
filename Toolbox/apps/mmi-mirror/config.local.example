# MMI Mirror V2.4 自定义显示布局配置模板
#
# 使用方法：
#   1. 如需恢复模板，可将本文件内容复制到同目录的 config.local。
#   2. 编辑 Toolbox/apps/mmi-mirror/config.local。
#   3. 进入 Toolbox -> MMI Mirror。
#   4. 执行：Install/Update custom display config。
#   5. 新参数会在 BaseVideo 下一次启动时生效。
#
# 参数说明：
#   - CROP_LEFT / RIGHT / TOP / BOTTOM：从原始 1024×480 MMI 画面四边分别裁掉的像素数。
#     四边完全独立；左右之和必须 < 1024，上下之和必须 < 480。
#   - SCALE：对裁切后的画面进行等比例缩放，必须 > 0 且 <= 4.0。
#   - OFFSET_X：最终画面水平偏移，正数向右，负数向左。
#   - OFFSET_Y：最终画面垂直偏移，正数向下，负数向上。
#   - V2.4 允许最终画面越过 1440×455 仪表边界；超出部分自然不可见，不会被自动推回屏幕内。
#

# CLASSIC_FULL：经典仪表布局 + FULL（大显示区域）
MMI_CLASSIC_FULL_CROP_LEFT=0
MMI_CLASSIC_FULL_CROP_RIGHT=0
MMI_CLASSIC_FULL_CROP_TOP=0
MMI_CLASSIC_FULL_CROP_BOTTOM=0
MMI_CLASSIC_FULL_SCALE=0.80
MMI_CLASSIC_FULL_OFFSET_X=0
MMI_CLASSIC_FULL_OFFSET_Y=0

# CLASSIC_SMALL：经典仪表布局 + SMALL（小显示区域）
MMI_CLASSIC_SMALL_CROP_LEFT=0
MMI_CLASSIC_SMALL_CROP_RIGHT=0
MMI_CLASSIC_SMALL_CROP_TOP=0
MMI_CLASSIC_SMALL_CROP_BOTTOM=0
MMI_CLASSIC_SMALL_SCALE=0.80
MMI_CLASSIC_SMALL_OFFSET_X=0
MMI_CLASSIC_SMALL_OFFSET_Y=0

# SPORT_FULL：运动仪表布局 + FULL（大显示区域）
MMI_SPORT_FULL_CROP_LEFT=0
MMI_SPORT_FULL_CROP_RIGHT=0
MMI_SPORT_FULL_CROP_TOP=0
MMI_SPORT_FULL_CROP_BOTTOM=0
MMI_SPORT_FULL_SCALE=0.80
MMI_SPORT_FULL_OFFSET_X=0
MMI_SPORT_FULL_OFFSET_Y=0

# SPORT_SMALL：运动仪表布局 + SMALL（小显示区域）
MMI_SPORT_SMALL_CROP_LEFT=0
MMI_SPORT_SMALL_CROP_RIGHT=0
MMI_SPORT_SMALL_CROP_TOP=0
MMI_SPORT_SMALL_CROP_BOTTOM=0
MMI_SPORT_SMALL_SCALE=0.80
MMI_SPORT_SMALL_OFFSET_X=0
MMI_SPORT_SMALL_OFFSET_Y=0
