# MMI Mirror V2.4 自定义显示布局配置
#
# 使用方法：
#   1. 本文件会随 V2.4 完整安装自动写入车机。
#   2. 如后续仅修改参数，可在 SD 卡上编辑：Toolbox/apps/mmi-mirror/config.local
#   3. 进入 Toolbox -> MMI Mirror -> Install/Update custom display config
#   4. 新参数会在 BaseVideo 下一次启动时生效。
#
# 说明：
#   - 四组参数分别对应 CLASSIC/SPORT × FULL/SMALL 四种仪表状态。
#   - FULL / SMALL 指中间内容显示区域大小，不是圆盘大小。
#   - CROP_LEFT / RIGHT / TOP / BOTTOM：从原始 1024×480 MMI 画面的四条边分别裁掉多少像素。
#   - SCALE：对“裁切后的画面”进行等比例缩放。
#   - OFFSET_X：最终画面水平位置偏移；正数向右，负数向左。
#   - OFFSET_Y：最终画面垂直位置偏移；正数向下，负数向上。
#   - V2.4 不再把最终画面强行夹回 1440×455 内；超出仪表边界的部分由 OpenGL 自然裁掉。
#
# 当前默认布局策略：
#   - FULL：保留完整 MMI/CarPlay 画面，仅把 SCALE 从 0.80 暂降到 0.70。
#   - SMALL：首轮按当前 CarPlay Dashboard 参考图估算，仅保留左侧地图卡片区域。
#            左侧约裁掉 CarPlay Dock 110 px，右侧约裁掉导航/媒体卡片 420 px，
#            上下暂不裁切，因此剩余源区域约 494×480；SCALE=0.70 后约 346×336。
#   - CLASSIC_SMALL：裁切后的地图保持水平居中。
#   - SPORT_SMALL：裁切后的地图贴左显示；在当前 346 px 目标宽度下 OFFSET_X=-547 可使 x≈0。
#
# SMALL 的左右裁切是根据当前参考照片做的首轮估算，上车后可根据实际 CarPlay 像素布局继续微调。
#

# ============================================================
# CLASSIC_FULL
# 经典仪表布局 + FULL（大显示区域）
# 完整画面；仅缩放到 0.70
# ============================================================
MMI_CLASSIC_FULL_CROP_LEFT=0
MMI_CLASSIC_FULL_CROP_RIGHT=0
MMI_CLASSIC_FULL_CROP_TOP=0
MMI_CLASSIC_FULL_CROP_BOTTOM=0
MMI_CLASSIC_FULL_SCALE=0.85
MMI_CLASSIC_FULL_OFFSET_X=0
MMI_CLASSIC_FULL_OFFSET_Y=40

# ============================================================
# CLASSIC_SMALL
# 经典仪表布局 + SMALL（小显示区域）
# 仅截取 CarPlay 左侧地图区域，水平居中
# ============================================================
MMI_CLASSIC_SMALL_CROP_LEFT=220
MMI_CLASSIC_SMALL_CROP_RIGHT=20
MMI_CLASSIC_SMALL_CROP_TOP=0
MMI_CLASSIC_SMALL_CROP_BOTTOM=0
MMI_CLASSIC_SMALL_SCALE=1
MMI_CLASSIC_SMALL_OFFSET_X=0
MMI_CLASSIC_SMALL_OFFSET_Y=50
# ============================================================
# SPORT_FULL
# 运动仪表布局 + FULL（大显示区域）
# 完整画面；仅缩放到 0.70
# ============================================================
MMI_SPORT_FULL_CROP_LEFT=0
MMI_SPORT_FULL_CROP_RIGHT=0
MMI_SPORT_FULL_CROP_TOP=0
MMI_SPORT_FULL_CROP_BOTTOM=0
MMI_SPORT_FULL_SCALE=0.85
MMI_SPORT_FULL_OFFSET_X=0
MMI_SPORT_FULL_OFFSET_Y=40

# ============================================================
# SPORT_SMALL
# 运动仪表布局 + SMALL（小显示区域）
# 仅截取 CarPlay 左侧地图区域，并贴到仪表左边显示
# 494×480 @ 0.70 -> 约 346×336；1440 输出下居中 x=547，因此 OFFSET_X=-547 -> x≈0
# ============================================================
MMI_SPORT_SMALL_CROP_LEFT=220
MMI_SPORT_SMALL_CROP_RIGHT=0
MMI_SPORT_SMALL_CROP_TOP=0
MMI_SPORT_SMALL_CROP_BOTTOM=0
MMI_SPORT_SMALL_SCALE=1.03
MMI_SPORT_SMALL_OFFSET_X=-517
MMI_SPORT_SMALL_OFFSET_Y=-60
